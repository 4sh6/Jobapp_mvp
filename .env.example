# JobApp Environment Configuration Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to Git

# ===== EMAIL CONFIGURATION =====
# Gmail SMTP Settings
# Get App Password from: https://myaccount.google.com/apppasswords
# (Requires 2FA enabled on Google Account)

MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# ===== GOOGLE OAUTH2 CONFIGURATION =====
# For "Sign in with Google" feature
# Get credentials from: https://console.cloud.google.com/

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== DATABASE CONFIGURATION =====
# H2 In-Memory (Development - data lost on restart)
DB_URL=jdbc:h2:mem:testdb
DB_USERNAME=sa
DB_PASSWORD=

# MySQL Example:
# DB_URL=jdbc:mysql://localhost:3306/jobapp
# DB_USERNAME=jobapp_user
# DB_PASSWORD=secure_password

# PostgreSQL Example:
# DB_URL=jdbc:postgresql://localhost:5432/jobapp
# DB_USERNAME=jobapp_user
# DB_PASSWORD=secure_password

