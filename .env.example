# JobApp Environment Configuration Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to Git

# ===== EMAIL CONFIGURATION =====
# Gmail SMTP Settings
# Get App Password from: https://myaccount.google.com/apppasswords
# (Requires 2FA enabled on Google Account)

MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# ===== GOOGLE OAUTH2 CONFIGURATION =====
# For "Sign in with Google" feature
# Get credentials from: https://console.cloud.google.com/

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== DATABASE CONFIGURATION =====
# --- Development (H2 in-memory, data lost on restart) ---
DB_URL=jdbc:h2:mem:testdb
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
DB_DIALECT=org.hibernate.dialect.H2Dialect

# --- Production: CockroachDB (10 GB free forever, no credit card) ---
# Steps to get your connection string:
#   1. Go to cockroachlabs.com → Create a free Serverless cluster
#   2. Choose a cloud region (e.g. AWS us-east-1)
#   3. Click "Connect" → "Connection parameters"
#   4. Copy the values below from the connection dialog
#
# DB_URL=jdbc:postgresql://<cluster-host>:26257/defaultdb?sslmode=verify-full
# DB_USERNAME=<your-sql-username>
# DB_PASSWORD=<your-sql-password>
# DB_DRIVER=org.postgresql.Driver
# DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ===== ADMIN PORTAL =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
ADMIN_JWT_SECRET=change-me-to-a-256-bit-secret-key-for-production-use

