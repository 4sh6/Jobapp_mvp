# koderhyre production environment — copy to `.env` in the repo root ON THE VM.
#
#   cp env.template .env && nano .env
#   chmod 600 .env
#
# Every value below comes from Render's env page — copy them BEFORE you
# decommission anything there:
#   https://dashboard.render.com/web/srv-d9l2vj0u01pc73ep668g/env
#   (values are masked; click the eye icon on each to reveal)
#
# NEVER commit this file once filled. Confirm .env is gitignored.

# --- Public URL -------------------------------------------------------------
# Used for OAuth redirect building and links in transactional email.
# A wrong value here silently breaks Google sign-in.
APP_BASE_URL=https://koderhyre.com

# --- Database: CockroachDB Cloud (unchanged by this migration) --------------
# DB_URL is the JDBC form, e.g.
#   jdbc:postgresql://<host>.cockroachlabs.cloud:26257/<db>?sslmode=verify-full
# The CA cert is baked into the image at /root/.postgresql/root.crt by the
# Dockerfile, so sslmode=verify-full works inside the container with no extra
# setup.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.CockroachDialect

# --- Résumé storage: Cloudflare R2 (unchanged) ------------------------------
# If these are blank the app silently falls back to local disk under
# ./uploads/resumes INSIDE the container — which is lost on every rebuild.
# Do not leave them empty in production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=koderhyre-resumes

# --- Transactional email: Resend HTTP API -----------------------------------
# Without RESEND_API_KEY, EmailService only logs emails to the console — OTP
# verification will appear to work but no mail is delivered.
RESEND_API_KEY=
RESEND_FROM_EMAIL=KoderHyre <noreply@koderhyre.com>

# --- Google OAuth (jobseeker sign-in) ---------------------------------------
# The existing client already allows koderhyre.com, so no console change is
# needed while the domain stays the same.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin ------------------------------------------------------------------
# ADMIN_USERNAME was never set on Render, so the code default 'admin' applied.
# Set it explicitly here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# --- Safety -----------------------------------------------------------------
# Must stay false in production — the H2 console is a dev-only convenience.
H2_CONSOLE_ENABLED=false
